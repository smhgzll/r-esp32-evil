+static int BenchFind(int stage, int room)
+{
+    for (int i = 0; i < s_benchCount; i++) {
+        if (s_benchList[i] == ((stage << 8) | room)) return i;
+    }
+    return -1;
+}
+
+// display_room_camera_bg walks the switch-zone table with no bound, so only
+// cameras that own a group are offered (a few rooms have cutscene-only ones).
+// The table ends with camTo 0xFFFF.
+static int BenchCamHasGroup(int cam)
+{
+    if (g_RdtPointer == NULL || g_RdtPointer->cam_switch_zones == NULL) return 0;
+    const CAM_SWITCH_ZONE* zone = (const CAM_SWITCH_ZONE*)g_RdtPointer->cam_switch_zones;
+    for (int i = 0; i < 1024; i++, zone++) {
+        if ((unsigned short)zone->camTo == 0xFFFF) return 0;
+        if ((unsigned short)zone->camFrom == (unsigned short)cam) return 1;
+    }
+    return 0;
+}
+
+// "1234 KB free, largest 512 KB" (targets that report it), else "".
+static const char* BenchHeap(void)
+{
+    static char text[48];
+    const long freeKb = re1t_heap_free() / 1024, largestKb = re1t_heap_largest() / 1024;
+    if (freeKb > 0) sprintf(text, ", heap %ld KB free (largest %ld KB)", freeKb, largestKb);
+    else text[0] = 0;
+    return text;
+}
+
+static void BenchFinishRoom(void)
+{
+    if (!s_benchRoomOn) return;
+    s_benchRoomOn = 0;
+    const int entry = s_benchList[s_benchPos];
+    const int fps10 = s_benchFrameMs > 0 ? (int)(s_benchFrames * 10000u / s_benchFrameMs) : 0;
+    fprintf(stderr, "[BENCH]   %X: %d.%d fps over %u frames, worst frame %lu ms, %d hitches,"
+            " slowest camera cut %lu ms\n", BenchRoomHex(entry), fps10 / 10, fps10 % 10,
+            s_benchFrames, (unsigned long)s_benchWorst, s_benchHitches,
+            (unsigned long)s_benchCutMax);
+
+    s_benchVisited++;
+    s_benchLoadSum += s_benchRoomLoad;
+    if (s_benchRoomLoad > s_benchSlowLoad) { s_benchSlowLoad = s_benchRoomLoad; s_benchSlowLoadAt = entry; }
+    if (s_benchFrames >= 10 && fps10 < s_benchLowFps10) { s_benchLowFps10 = fps10; s_benchLowFpsAt = entry; }
+    if ((int)s_benchWorst > s_benchWorstFrame) { s_benchWorstFrame = (int)s_benchWorst; s_benchWorstFrameAt = entry; }
+    if ((int)s_benchCutMax > s_benchSlowCut) { s_benchSlowCut = (int)s_benchCutMax; s_benchSlowCutAt = entry; }
+    if (s_benchHitches > 0) { s_benchHitchRooms++; s_benchHitchTotal += s_benchHitches; }
+}
+
+static void BenchSummary(const char* how)
+{
+    if (s_benchVisited == 0) return;
+    fprintf(stderr, "[BENCH] ===== room tour %s: %d rooms in %lu s =====\n", how, s_benchVisited,
+            (unsigned long)((plat_time_ms() - s_benchStart) / 1000));
+    fprintf(stderr, "[BENCH] load: average %ld ms, slowest %d ms (%X %s)\n",
+            s_benchLoadSum / s_benchVisited, s_benchSlowLoad, BenchRoomHex(s_benchSlowLoadAt),
+            BenchRoomName(s_benchSlowLoadAt));
+    if (s_benchLowFps10 < 100000) {
+        fprintf(stderr, "[BENCH] lowest frame rate: %d.%d fps (%X %s)\n", s_benchLowFps10 / 10,
+                s_benchLowFps10 % 10, BenchRoomHex(s_benchLowFpsAt), BenchRoomName(s_benchLowFpsAt));
+    }
+    fprintf(stderr, "[BENCH] worst frame: %d ms (%X %s); slowest camera cut: %d ms (%X %s)\n",
+            s_benchWorstFrame, BenchRoomHex(s_benchWorstFrameAt), BenchRoomName(s_benchWorstFrameAt),
+            s_benchSlowCut, BenchRoomHex(s_benchSlowCutAt), BenchRoomName(s_benchSlowCutAt));
+    fprintf(stderr, "[BENCH] hitches (frames over %d ms): %d in %d rooms%s\n",
+            BENCH_HITCH_MS, s_benchHitchTotal, s_benchHitchRooms, BenchHeap());
+}
+
+static void BenchCameraTo(int n);
+
+// Start gathering numbers for the room that is on screen now.
+static void BenchEnterRoom(DWORD now)
+{
+    for (int j = 0; j < 8; j++) {
+        g_ScdEventTable[j].active = 0;      // nothing queued by the room's init runs
+    }
+    s_benchCamCount = 0;
+    s_benchCamIdx = 0;
+    const int cams = g_RdtPointer != NULL ? g_RdtPointer->cameras_count : 0;
+    for (int c = 0; c < cams && s_benchCamCount < BENCH_MAX_CAMS; c++) {
+        if (BenchCamHasGroup(c)) {
+            if (c == g_roomCameraId) s_benchCamIdx = s_benchCamCount;
+            s_benchCams[s_benchCamCount++] = c;
+        }
+    }
+    s_benchFrames = 0;
+    s_benchFrameMs = s_benchWorst = s_benchCutMax = 0;
+    s_benchHitches = 0;
+    s_benchRoomOn = 1;
+    s_benchLast = now;
+    s_benchCamSince = now;
+
+    const int entry = s_benchList[s_benchPos];
+    fprintf(stderr, "[BENCH] %d/%d %X %s: load %d ms (with door %d ms), %d cameras%s\n",
+            s_benchPos + 1, s_benchCount, BenchRoomHex(entry), BenchRoomName(entry),
+            s_benchRoomLoad, s_benchRoomDoor, s_benchCamCount, BenchHeap());
+    if (s_benchJumpCam > 0) {               // re1bench_camera before the jump
+        const int n = s_benchJumpCam;
+        s_benchJumpCam = 0;
+        s_benchCamPending = 0;
+        BenchCameraTo(n);
+    }
+}
+
+static void BenchGo(void)
+{
+    BenchFinishRoom();
+    const int entry = s_benchList[s_benchPos];
+    s_dbgStage = entry >> 8;
+    s_dbgRoom = entry & 0xFF;
+    s_benchLoaded = 0;
+    s_benchLoading = 1;
+    s_benchTrigger = plat_time_ms();
+    DebugRoomChange_Trigger();
+}
+
+static void BenchStep(int dir)
+{
+    BenchFinishRoom();                      // logged under the room being left
+    s_benchPos = (s_benchPos + dir + s_benchCount) % s_benchCount;
+    BenchGo();
+}
+
+static void BenchCamera(int dir)
+{
+    if (s_benchCamCount <= 1) return;
+    s_benchCamIdx = (s_benchCamIdx + dir + s_benchCamCount) % s_benchCamCount;
+    const int cam = s_benchCams[s_benchCamIdx];
+    const DWORD t0 = plat_time_ms();
+    g_roomCameraId = (unsigned char)cam;
+    StMask(0, 4);                           // as check_camera_switch's cut
+    display_room_camera_bg();
+    const DWORD now = plat_time_ms();
+    const DWORD ms = now - t0;
+    if (ms > s_benchCutMax) s_benchCutMax = ms;
+    s_benchLast = now;                      // the cut is timed on its own
+    s_benchCamSince = now;
+    fprintf(stderr, "[BENCH]   camera %d: cut %lu ms\n", cam, (unsigned long)ms);
+}
+
+// To the n-th of the room's cameras, 1-based as the band counts them.
+static void BenchCameraTo(int n)
+{
+    if (n < 1 || n > s_benchCamCount) {
+        fprintf(stderr, "[BENCH] camera %d: the room has %d\n", n, s_benchCamCount);
+        return;
+    }
+    if (n - 1 != s_benchCamIdx) BenchCamera(n - 1 - s_benchCamIdx);
+}
+
+static void BenchStop(const char* how)
+{
+    BenchFinishRoom();
+    BenchSummary(how);
+    re1port_set_cheat(0, s_benchSavedCheat[0]);
+    re1port_set_cheat(1, s_benchSavedCheat[1]);
+    g_re1benchActive = 0;
+    s_benchAuto = 0;
+    s_benchLoading = 0;
+    s_benchEnding = 0;
+}
+
+static void BenchStart(int mode)
+{
+    if (s_benchCount < 0) BenchBuildList();
+    if (s_benchCount <= 0) {
+        fprintf(stderr, "[BENCH] no rooms found\n");
+        return;
+    }
+    const DWORD now = plat_time_ms();
+    s_benchSavedCheat[0] = re1port_cheat(0);
+    s_benchSavedCheat[1] = re1port_cheat(1);
+    s_benchSavedVariant = Flg_ck((int)g_ScenarioFlags, SCENARIO_FLAG_STAGE_VARIANT) != 0;
+    re1port_set_cheat(0, 1);
+    re1port_set_cheat(1, 1);
+    g_re1benchActive = 1;
+    s_benchStart = now;
+    s_benchVisited = s_benchHitchRooms = s_benchHitchTotal = 0;
+    s_benchLoadSum = 0;
+    s_benchSlowLoad = s_benchWorstFrame = s_benchSlowCut = -1;
+    s_benchLowFps10 = 100000;
+    s_benchPrevKeys = DebugMenu_SampleKeys();   // the key that started it is still down
+    s_benchHome = BenchFind(g_stageId, g_roomId);
+    s_benchAuto = (mode == 2);
+    s_benchAutoLeft = s_benchCount;
+    s_benchRoomLoad = s_benchRoomDoor = 0;
+    fprintf(stderr, "[BENCH] room tour started (%s)\n", s_benchAuto ? "auto" : "manual");
+    // Where to begin: a room asked for by name (re1bench_goto, the
+    // RE1_BENCH_START=<hex> environment variable on the host), else the room
+    // the player is in (ROOM TOUR) or the first room (AUTO TOUR).
+    int hex = s_benchJumpHex;
+    s_benchJumpHex = 0;
+    if (hex == 0) {
+        if (const char* env = getenv("RE1_BENCH_START")) hex = (int)strtol(env, NULL, 16);
+        if (s_benchJumpCam == 0) {
+            if (const char* env = getenv("RE1_BENCH_CAM")) s_benchJumpCam = atoi(env);
+        }
+    }
+    int first = -1;
+    if (hex != 0) {
+        first = BenchFind((hex >> 8) - 1, hex & 0xFF);
+        if (first < 0) fprintf(stderr, "[BENCH] room %X is not in the list\n", hex);
+    }
+    if (first < 0) first = (mode == 1 && s_benchHome >= 0) ? s_benchHome : 0;
+    s_benchPos = first;
+    if (first == s_benchHome) {
+        BenchEnterRoom(now);
+    } else {
+        BenchGo();
+    }
+}
+
+void re1bench_request(int mode)
+{
+    g_re1benchRequest = mode;
+}
+
+// A room by its hex id (0x112 = ROOM 112; 0 = the list's first): straight
+// there on a running tour, else the tour starts there - from the title with a
+// new game (TitleScreen.cpp). Called on the game thread (re1_remote_poll).
+void re1bench_goto(int hexRoom, int mode)
+{
+    s_benchJumpHex = hexRoom;
+    if (g_re1benchActive) {
+        s_benchJumpMode = mode;
+        s_benchJumpPending = 1;
+    } else {
+        g_re1benchRequest = mode;
+    }
+}
+
+// The n-th camera (1-based, as the band counts them) of the room a pending
+// re1bench_goto lands in; with no jump pending on a running tour, of the room
+// on screen, at once. Call it after re1bench_goto.
+void re1bench_camera(int n)
+{
+    s_benchJumpCam = n;
+    s_benchCamPending = (g_re1benchActive && !s_benchJumpPending && !s_benchLoading) ? 1 : 0;
+}
+
+void re1bench_stop(void)
+{
+    g_re1benchRequest = 0;
+    if (g_re1benchActive) s_benchStopPending = 1;
+}
+
+// CANCEL: back to the room the tour started in, then normal play. 1 while a
+// transition home runs.
+static int BenchEnd(void)
+{
+    s_benchAuto = 0;
+    if (s_benchHome >= 0 && s_benchHome != s_benchPos) {
+        BenchFinishRoom();
+        s_benchEnding = 1;
+        s_benchPos = s_benchHome;
+        BenchGo();
+        return 1;
+    }
+    BenchStop("ended");
+    return 0;
+}
+
+// Called by game_loop on every gameplay frame. 1 while the tour runs.
+int re1bench_frame(void)
+{
+    g_re1portGameplayFrames++;
+    if (g_re1benchRequest != 0) {
+        const int mode = g_re1benchRequest;
+        g_re1benchRequest = 0;
+        if (!g_re1benchActive) BenchStart(mode);
+        return g_re1benchActive;
+    }
+    if (!g_re1benchActive) return 0;
+
+    const DWORD now = plat_time_ms();
+    if (s_benchLoading) {
+        if (!s_benchLoaded) return 1;       // the old room's frames before the door
+        s_benchLoading = 0;
+        s_benchRoomLoad = g_re1benchLoadMs;
+        s_benchRoomDoor = (int)(now - s_benchTrigger);
+        if (s_benchEnding) {
+            if (!s_benchSavedVariant) {     // the player's own mansion again
+                FUN_00473f10((int*)g_ScenarioFlags, SCENARIO_FLAG_STAGE_VARIANT);
+            } else {
+                Flg_on((int)g_ScenarioFlags, SCENARIO_FLAG_STAGE_VARIANT);
+            }
+            BenchStop("ended");
+            return 0;
+        }
+        BenchEnterRoom(now);
+    } else if (s_benchRoomOn) {
+        const DWORD dt = now - s_benchLast;
+        s_benchFrames++;
+        s_benchFrameMs += dt;
+        if (dt > s_benchWorst) s_benchWorst = dt;
+        if (dt > BENCH_HITCH_MS) {
+            // Counted always; logged only for the first few of a room (a slow
+            // room is slow every frame - the room's summary line says so).
+            if (++s_benchHitches <= 3) {
+                fprintf(stderr, "[BENCH]   hitch: %lu ms frame\n", (unsigned long)dt);
+            }
+        }
+    }
+    s_benchLast = now;
+
+    if ((g_main_state_flags & MSF_PLAYER_DEAD) != 0) {
+        BenchStop("stopped (player dead)");
+        return 0;
+    }
+
+    const int keys = DebugMenu_SampleKeys();
+    const int newKeys = keys & ~s_benchPrevKeys;
+    s_benchPrevKeys = keys;
+
+    if ((newKeys & DBGKEY_ESC) || s_benchStopPending) {
+        s_benchStopPending = 0;
+        return BenchEnd();
+    }
+    if (s_benchCamPending && !s_benchJumpPending) {   // re1bench_camera alone
+        s_benchCamPending = 0;
+        const int n = s_benchJumpCam;
+        s_benchJumpCam = 0;
+        BenchCameraTo(n);
+    }
+    if (s_benchJumpPending) {                // re1bench_goto on a running tour
+        s_benchJumpPending = 0;
+        const int hex = s_benchJumpHex;
+        s_benchJumpHex = 0;
+        const int at = hex != 0 ? BenchFind((hex >> 8) - 1, hex & 0xFF) : 0;
+        if (at >= 0 && at == s_benchPos && s_benchJumpCam > 0 && s_benchJumpMode == 1) {
+            const int n = s_benchJumpCam;     // the room on screen: only the camera
+            s_benchJumpCam = 0;
+            BenchCameraTo(n);
+            return 1;
+        }
+        if (at >= 0) {
+            s_benchAuto = (s_benchJumpMode == 2);
+            s_benchAutoLeft = s_benchCount;
+            BenchFinishRoom();
+            s_benchPos = at;
+            BenchGo();
+            return 1;
+        }
+        fprintf(stderr, "[BENCH] room %X is not in the list\n", hex);
+    }
+    if (newKeys & DBGKEY_CONFIRM) {
+        s_benchAuto = !s_benchAuto;
+        s_benchAutoLeft = s_benchCount;
+        s_benchCamSince = now;
+        fprintf(stderr, "[BENCH] auto %s\n", s_benchAuto ? "on" : "off");
+    }
+    if (newKeys & DBGKEY_RIGHT) { BenchStep(1);  return 1; }
+    if (newKeys & DBGKEY_LEFT)  { BenchStep(-1); return 1; }
+    if (newKeys & DBGKEY_UP)    BenchCamera(1);
+    if (newKeys & DBGKEY_DOWN)  BenchCamera(-1);
+
+    if (s_benchAuto && now - s_benchCamSince >= BENCH_AUTO_CAM_MS) {
+        if (s_benchCamIdx + 1 < s_benchCamCount) {
+            BenchCamera(1);
+        } else if (--s_benchAutoLeft <= 0) {
+            BenchFinishRoom();
+            BenchSummary("finished");
+            s_benchAuto = 0;
+            s_benchRoomOn = 0;              // numbers for the next room only
+        } else {
+            BenchStep(1);
+            return 1;
+        }
+    }
+
+    // The room's name and where the tour is, on a dark band at the bottom of
+    // the frame (drawn by the port's renderer, not the game's text layer, so
+    // the overlay does not weigh on the numbers it shows).
+    const int entry = s_benchList[s_benchPos];
+    char line1[40], line2[40];
+    snprintf(line1, sizeof(line1), "%X %s", BenchRoomHex(entry), BenchRoomName(entry));
+    snprintf(line2, sizeof(line2), "CAM %d/%d %d/%d%s", s_benchCamIdx + 1, s_benchCamCount,
+             s_benchPos + 1, s_benchCount, s_benchAuto ? " AUTO" : "");
+    re1port_set_status(line1, line2);
+    return 1;
+}
+#endif  // RE1_PORT_BENCH
