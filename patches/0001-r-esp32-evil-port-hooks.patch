+// PortProf.h - r-esp32-evil port: profiling scopes in game code.
+//
+// With RE1_PORT_PROFILE the port measures where a frame's time goes on the
+// target (port/include/re1_prof.h, the [PERF] console line); RE1_PROF(bucket)
+// charges the rest of the enclosing block to that bucket. Without it the
+// macro is empty and the code is exactly upstream's.
+#pragma once
+
+// RE1_HOT_FN: with RE1_PORT_FAST on the ESP32 target, a function the renderer
+// runs per vertex every frame is kept in internal RAM (IRAM). Empty elsewhere.
+#ifndef RE1_HOT_FN
+#if defined(RE1_PORT_FAST) && defined(ESP_PLATFORM)
+#include "esp_attr.h"
+#define RE1_HOT_FN IRAM_ATTR
+#else
+#define RE1_HOT_FN
+#endif
+#endif
+
+#if defined(RE1_PORT_PROFILE)
+#include "re1_prof.h"
+#define RE1_PROF(bucket) RE1_PROF_SCOPE(bucket)
+#define RE1_WORK(counter, n) RE1_WORK_ADD(counter, n)
+#else
+#define RE1_PROF(bucket) ((void)0)
+#define RE1_WORK(counter, n) ((void)0)
+#endif
