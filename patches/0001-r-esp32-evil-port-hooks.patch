+static int BenchRoomHex(int entry)
+{
+    return ((entry >> 8) + 1) * 0x100 + (entry & 0xFF);
+}
+
+static const char* BenchRoomName(int entry)
+{
+    const int stage = entry >> 8, room = entry & 0xFF;
+    if (stage >= DBG_STAGE_COUNT || room >= s_dbgStageRooms[stage].count) return "";
+    return s_dbgStageRooms[stage].names[room];
+}
+
+// Does the room ship a real RDT for the current character? (A few names in
+// the tables are 4-byte placeholders on disc.)
+static int BenchRoomFileOk(int stage, int room)
+{
+    static const char hexDigits[] = "0123456789abcdef";
+    const int variant = (g_main_state_flags & MSF_CHAR_VARIANT) ? 1 : 0;
+    char path[64], resolved[260], normalized[260];
+    sprintf(path, GAME_DATA_ROOT "stage%c\\room%c%c%c%c.rdt", hexDigits[stage + 1],
+            hexDigits[stage + 1], hexDigits[room >> 4], hexDigits[room & 0xF], hexDigits[variant]);
+    const char* filePath = ResolveAssetRoot(path, resolved, sizeof(resolved));
+    filePath = plat_normalize_path(filePath, normalized, sizeof(normalized));
+    FILE* fp = fopen(filePath, "rb");
+    if (fp == NULL) return 0;
+    fseek(fp, 0, SEEK_END);
+    const long size = ftell(fp);
+    fclose(fp);
+    return size > 0x94 + 0x100;
+}
+
+static void BenchBuildList(void)
+{
+    const DWORD t0 = plat_time_ms();
+    s_benchCount = 0;
+    for (int stage = 0; stage < DBG_STAGE_COUNT; stage++) {
+        for (int room = 0; room < s_dbgStageRooms[stage].count; room++) {
+            if (s_benchCount < BENCH_MAX_ROOMS && DebugRoomSelectable(stage, room) &&
+                BenchRoomFileOk(stage, room)) {
+                s_benchList[s_benchCount++] = (unsigned short)((stage << 8) | room);
+            }
+        }
+    }
+    fprintf(stderr, "[BENCH] %d rooms to visit (list built in %lu ms)\n", s_benchCount,
+            (unsigned long)(plat_time_ms() - t0));
+}
