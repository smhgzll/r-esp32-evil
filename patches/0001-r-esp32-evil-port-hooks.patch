diff --git a/src/PortMem.h b/src/PortMem.h
new file mode 100644
index 0000000..16ec1c0
--- /dev/null
+++ b/src/PortMem.h
@@ -0,0 +1,42 @@
+// PortMem.h - r-esp32-evil port: memory-footprint switches.
+//
+// The PC build keeps several large scratch arrays as function-local statics
+// (multi-megabyte .bss). On a target with 8 MB of PSRAM, RE1_SMALL_MEM turns
+// them into heap buffers that live only for the call that needs them, and
+// trims the port-added headroom of a few pools. With RE1_SMALL_MEM undefined
+// every site compiles exactly as upstream.
+#pragma once
+
+#include <stdlib.h>
+#include <string.h>
+
+// The port's big-temporary allocator (port/common/BigAlloc.cpp): a block
+// reserved at boot for the 256 KB pictures room loads build again and again.
+extern "C" void* re1port_big_alloc(size_t size);
+extern "C" void  re1port_big_free(void* p);
+
+// A call-scoped buffer. NULL (p == NULL) when memory is exhausted: callers
+// check and skip their work rather than abort the game.
+template <typename T>
+struct Re1Scratch {
+    T* p;
+    explicit Re1Scratch(size_t n) : p(NULL) {
+        if (n == 0) return;
+        p = (T*)re1port_big_alloc(n * sizeof(T));
+        if (p != NULL) memset((void*)p, 0, n * sizeof(T));
+    }
+    ~Re1Scratch() { re1port_big_free(p); }
+    T& operator[](size_t i) { return p[i]; }
+    operator T*() { return p; }
+    Re1Scratch(const Re1Scratch&) = delete;
+    Re1Scratch& operator=(const Re1Scratch&) = delete;
+};
+
+// Declare `name` as `type name[count]`: a static array normally, a call-scoped
+// heap buffer under RE1_SMALL_MEM. `type` may itself be an array type.
+#if defined(RE1_SMALL_MEM)
+#define RE1_SCRATCH(type, name, count) Re1Scratch<type> name(count)
+#else
+template <typename T, size_t N> using Re1StaticArr = T[N];
+#define RE1_SCRATCH(type, name, count) static Re1StaticArr<type, count> name
+#endif
