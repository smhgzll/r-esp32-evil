+// r-esp32-evil: read `n` bytes of a game file from `offset` (short reads are
+// zero-filled); the file's size goes to *outSize. 0 = no such file.
+static int DebugRoom_ReadPart(const char* path, unsigned int offset, unsigned char* buf,
+                              size_t n, size_t* outSize)
+{
+    char resolved[260], normalized[260];
+    const char* filePath = ResolveAssetRoot(path, resolved, sizeof(resolved));
+    filePath = plat_normalize_path(filePath, normalized, sizeof(normalized));
+    FILE* fp = fopen(filePath, "rb");
+    if (fp == NULL) return 0;
+    fseek(fp, 0, SEEK_END);
+    const long fileSize = ftell(fp);
+    if (outSize != NULL) *outSize = fileSize > 0 ? (size_t)fileSize : 0;
+    memset(buf, 0, n);
+    int ok = fileSize > 0 && (long)offset < fileSize && fseek(fp, (long)offset, SEEK_SET) == 0;
+    if (ok) fread(buf, 1, n, fp);
+    fclose(fp);
+    return ok;
+}
+#endif
