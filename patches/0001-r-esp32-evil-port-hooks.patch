+// ============================================================================
+// Externally provided switch primitives (r-esp32-evil port).
+//
+// Targets without ucontext (ESP-IDF / FreeRTOS on Xtensa) supply the three
+// primitives themselves; the contract is the ucontext one below: Start runs a
+// fresh task body on slot `id` until it yields, Resume continues it where it
+// yielded, Yield (called on the task) hands control back to the scheduler.
+// A slot that is restarted (Task_chain / a dead slot re-executed) is simply
+// started again: the port discards whatever was left of the old body, exactly
+// as makecontext discards the old ucontext.
+// ============================================================================
+extern "C" void re1port_task_start(int id, void (*entry)(void));
+extern "C" void re1port_task_resume(int id);
+extern "C" void re1port_task_yield(int id);
+
+void Task_exit(void);
+
+static void TaskEntry(void)
+{
+    void (*fn)(void) = (void (*)(void))g_TasksEIP[g_CurrentTaskID];
+    fn();
+    Task_exit();
+}
+
+static void TaskSwitch_Start(void)
+{
+    re1port_task_start(g_CurrentTaskID, TaskEntry);
+}
+
+static void TaskSwitch_Resume(void)
+{
+    re1port_task_resume(g_CurrentTaskID);
+}
+
+static void TaskYield(void)
+{
+    re1port_task_yield(g_CurrentTaskID);
+}
+
